---
import {
  SITE_INTRO_LEAD,
  SITE_INTRO_SHIPPED,
  SITE_INTRO_TOPICS,
} from '../lib/site';
---

<section class="hero" id="top">
  <div class="col">
    <p class="section-label">README.md</p>
    <h1 class="hero__title">
      <span class="visually-hidden">The Friday Hotfix</span>
      <span class="hero__title-anim" aria-hidden="true" data-title-anim>
        <!-- Empty for JS typing; no-JS fills via CSS ::before -->
        <span data-title-typed></span><span class="cursor">_</span>
      </span>
    </h1>
    <p class="hero__intro">
      <span class="hero__intro-line hero__intro-line--lead">
        {SITE_INTRO_LEAD} {SITE_INTRO_TOPICS}.
      </span>
      <span class="hero__intro-line">{SITE_INTRO_SHIPPED}</span>
    </p>
    <div class="hero__subscribe" id="subscribe">
      <form class="subscribe-form" data-subscribe-form novalidate>
        <label class="subscribe-form__label" for="subscribe-email">
          $ git remote add inbox
        </label>
        <input
          class="subscribe-form__input"
          id="subscribe-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@company.com"
          data-subscribe-input
        />
        <button class="subscribe-form__submit" type="submit" data-subscribe-submit>
          push ↵
        </button>
      </form>
      <p class="hero__status" role="status" data-subscribe-status aria-live="polite"></p>
    </div>
    <p class="hero__footnote">fridays · ~5 min · unsubscribe = git remote remove</p>
  </div>
</section>

<script>
  import '../scripts/title-typing.ts';
</script>
