---
import {
  GITHUB_URL,
  LINKEDIN_NEWSLETTER_URL,
  SITE_INTRO_LEAD,
  SITE_INTRO_SHIPPED,
  SITE_INTRO_TOPICS,
} from '../lib/site';
---

<section class="hero" id="top">
  <div class="col">
    <p class="section-label">README.md</p>
    <h1 class="hero__title">
      <span class="visually-hidden">The Friday Hotfix</span>
      <span class="hero__title-anim" aria-hidden="true" data-title-anim>
        <!-- Empty for JS typing; no-JS fills via CSS ::before -->
        <span data-title-typed></span><span class="cursor">_</span>
      </span>
    </h1>
    <p class="hero__intro">
      <span class="hero__intro-line hero__intro-line--lead">
        {SITE_INTRO_LEAD} {SITE_INTRO_TOPICS}.
      </span>
      <span class="hero__intro-line">{SITE_INTRO_SHIPPED}</span>
    </p>
    <div class="hero__follow">
      <div class="follow" id="follow" role="group" aria-labelledby="follow-label">
        <span class="follow__label" id="follow-label">$ git remote add friday</span>
        <a
          class="follow__link follow__link--primary"
          href={LINKEDIN_NEWSLETTER_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-hint="→ linkedin newsletter. lands in your feed every friday."
        >
          linkedin ↗
        </a>
        <a class="follow__link" href="/rss.xml" data-hint="→ /rss.xml. for people who still own a feed reader (respect).">
          rss
        </a>
        <a
          class="follow__link"
          href={`${GITHUB_URL}/releases`}
          target="_blank"
          rel="noopener noreferrer"
          data-hint="→ github releases. watch → custom → releases."
        >
          github ↗
        </a>
      </div>
      <p class="hero__hint" data-follow-hint>pick a remote. same patch notes on all three.</p>
    </div>
    <p class="hero__footnote">fridays · ~5 min · unfollow = git remote remove friday</p>
  </div>
</section>

<script>
  import '../scripts/title-typing.ts';
</script>
