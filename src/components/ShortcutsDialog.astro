<dialog class="shortcuts" aria-label="Keyboard shortcuts" data-shortcuts>
  <div class="shortcuts__header">
    <p class="shortcuts__title">$ man hotfix</p>
    <button class="shortcuts__close" type="button" data-shortcuts-close aria-label="Close">
      ×
    </button>
  </div>
  <div class="shortcuts__row">
    <span>j / k</span>
    <span class="shortcuts__desc">next / previous item</span>
  </div>
  <div class="shortcuts__row">
    <span>enter</span>
    <span class="shortcuts__desc">open selected link</span>
  </div>
  <div class="shortcuts__row">
    <span>o</span>
    <span class="shortcuts__desc">toggle --oneline</span>
  </div>
  <div class="shortcuts__row">
    <span>?</span>
    <span class="shortcuts__desc">show / hide this</span>
  </div>
  <div class="shortcuts__row">
    <span>esc</span>
    <span class="shortcuts__desc">close</span>
  </div>
</dialog>
