---
interface Props {
  /** '/' on pages without the log (404), so the links go back home. */
  base?: string;
}
const { base = '' } = Astro.props;
---

<header class="site-header">
  <div class="col site-header__inner">
    <a class="site-header__brand" href={`${base}#top`}>
      <svg class="site-header__mark" viewBox="0 0 64 64" width="24" height="24" aria-hidden="true">
        <path d="M24 10 V54" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" fill="none"></path>
        <path d="M24 18 C24 26 40 24 40 32 C40 40 24 38 24 46" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" fill="none"></path>
        <circle cx="40" cy="32" r="6" fill="var(--accent)"></circle>
        <g transform="translate(35.200 27.200) scale(0.1500)">
          <path d="M32 58 C18 58 12 48 13 39 C14 30 20 25 22 17 C26 21 27 25 27 28 C29 22 33 14 32 6 C40 12 50 23 51 37 C52 49 45 58 32 58 Z" fill="#fff"></path>
          <circle cx="26.5" cy="41" r="4.2" fill="var(--accent)"></circle>
          <circle cx="37.5" cy="41" r="4.2" fill="var(--accent)"></circle>
          <path d="M27 47.5 Q32 52 37 47.5" fill="none" stroke="var(--accent)" stroke-width="4.5" stroke-linecap="round"></path>
        </g>
      </svg>
      <span>
        <span class="site-header__brand-muted">max-roux/</span><span class="site-header__brand-name">the-friday-hotfix_</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Site">
      <a href={`${base}#log`}>log</a>
      <a href={`${base}#blame`}>blame</a>
      <a href={`${base}#follow`}>follow</a>
    </nav>
  </div>
</header>
