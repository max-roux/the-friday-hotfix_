---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  canonicalPath?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogTitle = 'The Friday Hotfix',
  canonicalPath = '/',
} = Astro.props;

const canonical = new URL(canonicalPath, SITE_URL).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Decides before first paint whether the hero title types itself; title-typing.ts follows this class. -->
    <script is:inline>
      (function () {
        var key = 'fh-title-typed';
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var force = /(?:\?|&)retype(?:&|=|$)/.test(location.search);
          if (force) localStorage.removeItem(key);
          var done = localStorage.getItem(key) === '1';
          var isDev =
            location.hostname === 'localhost' || location.hostname === '127.0.0.1';
          // Mark before paint so CSS can hide the finished title and avoid a flash.
          if (!reduce && (force || isDev || !done)) {
            root.classList.add('title-will-type');
          }
        } catch (e) {
          root.classList.add('title-will-type');
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="The Friday Hotfix" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-plex" preload />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
