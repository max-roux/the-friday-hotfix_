// Cloudflare Workers config: serves the static Astro build from ./dist.
{
  "name": "the-friday-hotfix",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    // dist/404.html for unknown paths
    "not_found_handling": "404-page",
    // matches trailingSlash: 'never' in astro.config.mjs (/v2026.41, not /v2026.41/)
    "html_handling": "drop-trailing-slash"
  },
  // Required by `wrangler preview` for PR preview builds; may stay empty.
  "previews": {}
}
