# Production site URL used in Slack copy + canonical/OG URLs (required to build)
PUBLIC_SITE_URL=https://fridayhotfix.example

# LinkedIn profile for the blame section
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-handle

# Follow prompt: LinkedIn newsletter (falls back to the profile above until it exists)
PUBLIC_LINKEDIN_NEWSLETTER_URL=

# Follow prompt: GitHub repo whose /releases readers watch (defaults to max-roux/thefridayhotfix)
PUBLIC_GITHUB_URL=
